# Copy this file to .env and adjust values before running the app.

# "development" or "production"
FLASK_ENV=development

# Used to sign session cookies and CSRF tokens. MUST be changed for production.
SECRET_KEY=change-this-to-a-long-random-secret-value

# SQLite file paths (relative to project root). Kept separate so dev data
# never contaminates a production database by accident.
DEV_DATABASE_URL=sqlite:///instance/dev.db
PROD_DATABASE_URL=sqlite:///instance/prod.db
